# Copiar a .env.ec2 en el servidor. No subir .env.ec2 a Git.
# Generar con: openssl rand -hex 32
POSTGRES_PASSWORD=

DEMO_USER=seminario
# Generar con: sudo docker run --rm -it caddy:2-alpine caddy hash-password
# Pegar el hash COMPLETO entre comillas simples para conservar sus signos $.
DEMO_PASSWORD_HASH=''

# Primera demo sin dominio: acceso solo por túnel SSH.
SITE_ADDRESS=http://localhost
LISTEN_IP=127.0.0.1
HTTP_PORT=8088
HTTPS_PORT=8443

# Cuando tengas un dominio, cambiar los cuatro valores anteriores por:
# SITE_ADDRESS=tienda.tudominio.com
# LISTEN_IP=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443
